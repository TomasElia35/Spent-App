# Credenciales de acceso a la app (usuario único)
APP_USERNAME=tu_usuario
APP_PASSWORD=una_contraseña_segura

# Secreto para firmar los JWT de sesión (string largo y aleatorio)
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio

# Supabase (Project Settings > API). ¡La service role key NUNCA va al frontend!
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar_por_service_role_key
